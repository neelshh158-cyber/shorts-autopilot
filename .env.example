# ---- Required: script writing (any one is enough; Groq is tried first) ----
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Required for uploading (see README, "Google setup") ----
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ---- Footage (optional, best quality first). With none set, the video uses
#      animated gradient backgrounds with big captions, which still works. ----
PEXELS_API_KEY=
PIXABAY_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# ---- Voice. Providers are tried in this order (override with TTS_ORDER):
#      edge (free, no key, blocked from some cloud IPs such as GitHub Actions)
#      gemini (free tier, needs GEMINI_API_KEY, best Hindi quality)
#      elevenlabs (needs ELEVENLABS_API_KEY and channel.elevenLabsVoiceId)
#      Word timings for captions come from the provider, else Groq Whisper
#      (GROQ_API_KEY), else are estimated. ----
TTS_ORDER=edge,gemini,elevenlabs
ELEVENLABS_API_KEY=

# ---- Testing ----
# SHORTS_MOCK=1   -> no network at all: canned script, beep voice, gradient visuals
